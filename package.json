{
  "name": "abi-oos-copilot",
  "version": "1.0.0",
  "description": "AI-Driven Out-of-Stock Copilot System for ABI Beer Distribution",
  "homepage": "https://sujoysahacodes.github.io/oos-push",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "cd server && npm run dev",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "vercel-build": "cd client && npm install && npm run build",
    "predeploy": "cd client && npm run build",
    "deploy": "gh-pages -d client/dist"
  },
  "keywords": [
    "out-of-stock",
    "logistics",
    "ai-copilot",
    "beer-distribution",
    "supply-chain",
    "inventory-management"
  ],
  "author": "Alcoholic Beverages of India",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0",
    "gh-pages": "^6.3.0"
  }
}
